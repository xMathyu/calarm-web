---
import { Image } from 'astro:assets';
import appIcon from '../assets/images/app-icon.png';
import LangMenu from './LangMenu.astro';
import { useTranslations } from '../i18n/utils';
import { landing } from '../i18n/landing';
import type { Lang } from '../i18n/ui';
import { APP_STORE_URL } from '../lib/appStore';

interface Props {
  lang: Lang;
  homeHref: string;
  /** This page in every locale, for the language menu. */
  langHrefs: Record<Lang, string>;
  /** On the landing the links are plain anchors; elsewhere they go home first. */
  onHome?: boolean;
}
const { lang, homeHref, langHrefs, onHome = false } = Astro.props;
const t = useTranslations(lang);
const base = onHome ? '' : homeHref;
const challengesId = landing[lang].features[0]?.id ?? 'features';
---

<nav class="nav" id="nav" aria-label="Calarmi">
  <div class="wrap row">
    <a href={homeHref} class="brand" aria-label="Calarmi">
      <Image src={appIcon} alt="" width={72} height={72} loading="eager" />
      <span class="wordmark" aria-hidden="true">calarm<span class="i">i</span></span>
    </a>
    <div class="nav-links">
      <a href={`${base}#features`}>{t('nav.features')}</a>
      <a href={`${base}#${challengesId}`}>{t('nav.challenges')}</a>
      <a href={`${base}#pricing`}>{t('nav.pricing')}</a>
      <a href={`${base}#privacy`}>{t('nav.privacy')}</a>
    </div>
    <div class="spacer"></div>
    <LangMenu lang={lang} hrefs={langHrefs} label={t('nav.language')} />
    <a class="cta" href={APP_STORE_URL} target="_blank" rel="noopener">{t('nav.get')}</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: background 0.3s ease, border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .nav:global(.scrolled) {
    background: rgba(11, 8, 7, 0.78);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-bottom-color: var(--hair);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 22px;
    height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand :global(img) {
    width: 36px;
    height: 36px;
    border-radius: 9px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 25px;
    letter-spacing: -0.03em;
  }
  .wordmark .i {
    color: var(--accent-3);
  }
  .nav-links {
    display: flex;
    gap: 24px;
    margin-left: 18px;
  }
  .nav-links a {
    color: var(--muted);
    font-size: 15px;
    font-weight: 550;
    padding: 10px 0;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .spacer {
    flex: 1;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--grad);
    color: #1a0c04;
    font-weight: 700;
    font-size: 15px;
    white-space: nowrap;
    box-shadow: 0 10px 30px rgba(241, 94, 31, 0.35);
    transition: transform 0.2s;
  }
  .cta:hover {
    transform: translateY(-1px);
  }
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .row {
      gap: 10px;
    }
    .wordmark {
      font-size: 22px;
    }
  }
  /* Icon, language and download don't fit next to the wordmark on a phone. */
  @media (max-width: 430px) {
    .wordmark {
      display: none;
    }
    .cta {
      padding: 0 14px;
      font-size: 14px;
    }
  }
</style>
