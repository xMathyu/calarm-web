---
import { APP_STORE_URL } from '../lib/appStore';

interface Props {
  /** "Descárgala en el" / "Download on the"… */
  line1: string;
  class?: string;
}
const { line1, class: cls } = Astro.props;
---

<a class:list={['store', cls]} href={APP_STORE_URL} target="_blank" rel="noopener">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 1.6c.1 1-.3 2-1 2.8-.7.8-1.8 1.4-2.8 1.3-.1-1 .4-2 1-2.7.7-.8 1.9-1.4 2.8-1.4ZM19.9 17c-.5 1.2-.8 1.7-1.4 2.8-1 1.5-2.3 3.4-4 3.4-1.5 0-1.9-1-3.9-1-2 0-2.5 1-4 1-1.6 0-2.9-1.7-3.8-3.2-2.6-4-2.9-8.8-1.3-11.3C2.7 6.6 4.4 5.5 6 5.5c1.6 0 2.6 1 3.9 1 1.3 0 2-1 3.9-1 1.4 0 2.9.8 4 2.1-3.5 1.9-2.9 6.9.1 9.4Z"></path></svg>
  <span class="txt"><span class="l1">{line1}</span><span class="l2">App Store</span></span>
</a>

<style>
  .store {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 0 24px 0 20px;
    border-radius: 16px;
    background: #fff;
    color: #0b0807;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .store:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 50px rgba(241, 94, 31, 0.35);
  }
  svg {
    width: 26px;
    height: 26px;
  }
  .txt {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    text-align: left;
  }
  .l1 {
    font-size: 12px;
    font-weight: 600;
  }
  .l2 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
</style>
