---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  img?: ImageMetadata;
  alt: string;
  /** CSS width of the frame, in px. */
  width?: number;
  eager?: boolean;
  class?: string;
}
const { img, alt, width = 300, eager = false, class: cls } = Astro.props;
---

<div class:list={['phone', cls]} style={`--pw:${width}px`}>
  <div class="screen">
    {
      img ? (
        <Image
          src={img}
          alt={alt}
          widths={[Math.round(width), Math.min(img.width, Math.round(width * 2))]}
          sizes={`${width}px`}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      ) : (
        <div class="missing" role="img" aria-label={alt} />
      )
    }
  </div>
  <div class="island" aria-hidden="true"></div>
</div>

<style>
  .phone {
    position: relative;
    width: var(--pw);
    max-width: 100%;
    padding: calc(var(--pw) * 0.03);
    border-radius: calc(var(--pw) * 0.165);
    background:
      linear-gradient(150deg, #5a4d47 0%, #1b1513 32%, #120e0c 68%, #3b322e 100%);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 calc(var(--pw) * 0.13) calc(var(--pw) * 0.33) rgba(0, 0, 0, 0.6);
  }
  .screen {
    border-radius: calc(var(--pw) * 0.137);
    overflow: hidden;
    background: #000;
    aspect-ratio: 660 / 1434;
  }
  .screen :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .missing {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, #1e1714, #0b0807);
  }
  .island {
    position: absolute;
    top: calc(var(--pw) * 0.058);
    left: 50%;
    width: 30%;
    height: calc(var(--pw) * 0.085);
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }
</style>
