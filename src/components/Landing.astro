---
import { Image } from 'astro:assets';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import IPhone from './IPhone.astro';
import appIcon from '../assets/images/app-icon.png';
import rawAlarms from '../assets/images/raw-4.png';
import rawRepeat from '../assets/images/raw-3.png';
import rawEvent from '../assets/images/raw-6.png';
import { useTranslations, pageHref } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const homeHref = pageHref('home', lang);
const policyHref = pageHref('privacy', lang);
const esHref = pageHref('home', 'es');
const enHref = pageHref('home', 'en');
const APP_STORE = 'https://apps.apple.com/pe/app/calarm-smart-alarms/id6772419323';
---

<Nav lang={lang} homeHref={homeHref} policyHref={policyHref} esHref={esHref} enHref={enHref} />

<span id="top"></span>

<!-- ================= HERO ================= -->
<header class="hero sec-pad">
  <div class="wrap hero-grid">
    <div class="reveal in">
      <span class="eyebrow">{t('hero.eyebrow')}</span>
      <h1><span>{t('hero.h1a')}</span><br /><span class="grad">{t('hero.h1b')}</span></h1>
      <p class="sub">{t('hero.sub')}</p>
      <div class="hero-cta">
        <a class="store-btn" href={APP_STORE} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 1.6c.1 1-.3 2-1 2.8-.7.8-1.8 1.4-2.8 1.3-.1-1 .4-2 1-2.7.7-.8 1.9-1.4 2.8-1.4ZM19.9 17c-.5 1.2-.8 1.7-1.4 2.8-1 1.5-2.3 3.4-4 3.4-1.5 0-1.9-1-3.9-1-2 0-2.5 1-4 1-1.6 0-2.9-1.7-3.8-3.2-2.6-4-2.9-8.8-1.3-11.3C2.7 6.6 4.4 5.5 6 5.5c1.6 0 2.6 1 3.9 1 1.3 0 2-1 3.9-1 1.4 0 2.9.8 4 2.1-3.5 1.9-2.9 6.9.1 9.4Z"></path></svg>
          <span><span class="l1">{t('store.l1')}</span><br /><span class="l2">App Store</span></span>
        </a>
        <a class="btn btn-ghost" href="#features">{t('hero.explore')}</a>
      </div>
      <div class="fineprint">
        <span><span class="dot"></span><span>{t('hero.f1')}</span></span>
        <span><span class="dot"></span><span>{t('hero.f2')}</span></span>
        <span><span class="dot"></span><span>{t('hero.f3')}</span></span>
      </div>
    </div>
    <div class="hero-visual reveal in">
      <IPhone img={rawAlarms} alt={t('hero.imgAlt')} width={330} glow eager />
    </div>
  </div>
</header>

<!-- ================= TRUST ================= -->
<section class="trust">
  <div class="wrap row">
    <div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg><span>{t('trust.1')}</span></div>
    <div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke-linecap="round"></path></svg><span>{t('trust.2')}</span></div>
    <div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" stroke-linecap="round"></path></svg><span>{t('trust.3')}</span></div>
    <div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-4Z" stroke-linejoin="round"></path></svg><span>{t('trust.4')}</span></div>
  </div>
</section>

<!-- ================= FEATURES GRID ================= -->
<section class="sec-pad" id="features">
  <div class="wrap">
    <div class="feat-head reveal">
      <h2><span>{t('feat.h2a')}</span> <span class="grad">{t('feat.h2b')}</span></h2>
      <p>{t('feat.p')}</p>
    </div>
    <div class="grid6">
      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" stroke-linecap="round" stroke-linejoin="round"></path><path d="M13.7 21a2 2 0 0 1-3.4 0" stroke-linecap="round"></path></svg></div>
        <h3>{t('g1.h')}</h3>
        <p>{t('g1.p')}</p>
      </div>
      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 11V9a4 4 0 0 1 4-4h14" stroke-linecap="round"></path><path d="M7 23l-4-4 4-4" stroke-linecap="round" stroke-linejoin="round"></path><path d="M21 13v2a4 4 0 0 1-4 4H3" stroke-linecap="round"></path></svg></div>
        <h3>{t('g2.h')}</h3>
        <p>{t('g2.p')}</p>
      </div>
      <div class="fcard reveal blue">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"></path></svg></div>
        <h3>{t('g3.h')}</h3>
        <p>{t('g3.p')}</p>
      </div>
      <div class="fcard reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 17h14l-1.5-5.5a2 2 0 0 0-2-1.5h-7a2 2 0 0 0-2 1.5L5 17Z" stroke-linejoin="round"></path><circle cx="7.5" cy="17.5" r="1.5"></circle><circle cx="16.5" cy="17.5" r="1.5"></circle></svg></div>
        <h3>{t('g4.h')}</h3>
        <p>{t('g4.p')}</p>
      </div>
      <div class="fcard reveal blue">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 9h18M8 13h5" stroke-linecap="round"></path><circle cx="16" cy="13.5" r="1"></circle></svg></div>
        <h3>{t('g5.h')}</h3>
        <p>{t('g5.p')}</p>
      </div>
      <div class="fcard reveal pink">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20v-1a4 4 0 0 1 4-4h2M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path><circle cx="9" cy="8" r="3"></circle><path d="M14 20v-1a4 4 0 0 1 4-4h0a4 4 0 0 1 4 4v1" stroke-linecap="round"></path></svg></div>
        <h3>{t('g6.h')}</h3>
        <p>{t('g6.p')}</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= SHOWCASE ROWS ================= -->
<section class="sec-pad showcase-bg">
  <div class="wrap">
    <!-- birthdays -->
    <div class="show reveal">
      <div class="copy">
        <span class="eyebrow">{t('s1.ey')}</span>
        <h2>{t('s1.h')}</h2>
        <p>{t('s1.p')}</p>
        <ul class="pts">
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s1.l1')}</span></li>
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s1.l2')}</span></li>
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s1.l3')}</span></li>
        </ul>
      </div>
      <div class="stage">
        <IPhone img={rawAlarms} alt={t('s1.imgAlt')} width={300} />
      </div>
    </div>

    <!-- recurrences -->
    <div class="show rev reveal">
      <div class="copy">
        <span class="eyebrow">{t('s2.ey')}</span>
        <h2>{t('s2.h')}</h2>
        <p>{t('s2.p')}</p>
        <ul class="pts">
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s2.l1')}</span></li>
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s2.l2')}</span></li>
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s2.l3')}</span></li>
        </ul>
      </div>
      <div class="stage">
        <IPhone img={rawRepeat} alt={t('s2.imgAlt')} width={300} />
      </div>
    </div>

    <!-- calendar + go -->
    <div class="show reveal">
      <div class="copy">
        <span class="eyebrow">{t('s3.ey')}</span>
        <h2>{t('s3.h')}</h2>
        <p>{t('s3.p')}</p>
        <ul class="pts">
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s3.l1')}</span></li>
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s3.l2')}</span></li>
          <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('s3.l3')}</span></li>
        </ul>
      </div>
      <div class="stage">
        <div class="tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>{t('s3.tag')}</span></div>
        <IPhone img={rawEvent} alt={t('s3.imgAlt')} width={300} />
      </div>
    </div>
  </div>
</section>

<!-- ================= MEETINGS ================= -->
<section class="meet sec-pad">
  <div class="wrap meet-grid">
    <div class="reveal">
      <span class="eyebrow">{t('m.ey')}</span>
      <h2>{t('m.h')}</h2>
      <p>{t('m.p')}</p>
      <div class="chips">
        <span class="chip"><span class="d" style="background:#5b5fc7"></span>Microsoft Teams</span>
        <span class="chip"><span class="d" style="background:#2d8cff"></span>Zoom</span>
        <span class="chip"><span class="d" style="background:#00ac47"></span>Google Meet</span>
      </div>
    </div>
    <div class="meet-visual reveal">
      <div class="meet-card">
        <div class="mi" style="background:rgba(91,95,199,.18);color:#9da0ff"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="13" height="12" rx="2"></rect><path d="M16 10l5-3v10l-5-3" stroke-linejoin="round"></path></svg></div>
        <div><h4>Team Sync</h4><p>2:00 PM · Microsoft Teams</p></div>
        <span class="join">{t('m.join')}</span>
      </div>
      <div class="meet-card">
        <div class="mi" style="background:rgba(45,140,255,.16);color:#7ab8ff"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="13" height="12" rx="2"></rect><path d="M16 10l5-3v10l-5-3" stroke-linejoin="round"></path></svg></div>
        <div><h4>Sprint Review</h4><p>4:30 PM · Zoom</p></div>
        <span class="join">{t('m.join')}</span>
      </div>
      <div class="meet-card">
        <div class="mi" style="background:rgba(0,172,71,.15);color:#5fd28a"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="13" height="12" rx="2"></rect><path d="M16 10l5-3v10l-5-3" stroke-linejoin="round"></path></svg></div>
        <div><h4>1:1 con Ana</h4><p>9:00 AM · Google Meet</p></div>
        <span class="join">{t('m.join')}</span>
      </div>
    </div>
  </div>
</section>

<!-- ================= PRIVACY ================= -->
<section class="priv sec-pad" id="privacy">
  <div class="wrap">
    <div class="reveal">
      <div class="lockwrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4" stroke-linecap="round"></path><circle cx="12" cy="16" r="1.3" fill="currentColor"></circle></svg></div>
      <h2>{t('p.h')}</h2>
      <p>{t('p.p')}</p>
    </div>
    <div class="priv-grid">
      <div class="priv-card reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="9" cy="11" r="2.2"></circle><path d="m6 19 4.5-4 3 2.5L17 13l4 4" stroke-linecap="round" stroke-linejoin="round"></path></svg></div>
        <h3>{t('p1.h')}</h3>
        <p>{t('p1.p')}</p>
      </div>
      <div class="priv-card reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"></path></svg></div>
        <h3>{t('p2.h')}</h3>
        <p>{t('p2.p')}</p>
      </div>
      <div class="priv-card reveal">
        <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.4 6A11 11 0 0 0 3 12a11 11 0 0 0 .6 3.5" stroke-linecap="round"></path><path d="m1 1 22 22" stroke-linecap="round"></path><path d="M9.5 9.5a3 3 0 0 0 4.2 4.2" stroke-linecap="round"></path></svg></div>
        <h3>{t('p3.h')}</h3>
        <p>{t('p3.p')}</p>
      </div>
    </div>
    <p class="priv-link"><a href={policyHref} class="btn btn-ghost">{t('p.link')}</a></p>
  </div>
</section>

<!-- ================= FINAL CTA ================= -->
<section class="final sec-pad">
  <div class="wrap">
    <div class="box reveal">
      <Image class="icon" src={appIcon} alt="Calarm" width={168} height={168} />
      <h2><span>{t('cta.h1')}</span> <span class="grad">{t('cta.h2')}</span></h2>
      <p>{t('cta.p')}</p>
      <div class="hero-cta">
        <a class="store-btn" href={APP_STORE} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 1.6c.1 1-.3 2-1 2.8-.7.8-1.8 1.4-2.8 1.3-.1-1 .4-2 1-2.7.7-.8 1.9-1.4 2.8-1.4ZM19.9 17c-.5 1.2-.8 1.7-1.4 2.8-1 1.5-2.3 3.4-4 3.4-1.5 0-1.9-1-3.9-1-2 0-2.5 1-4 1-1.6 0-2.9-1.7-3.8-3.2-2.6-4-2.9-8.8-1.3-11.3C2.7 6.6 4.4 5.5 6 5.5c1.6 0 2.6 1 3.9 1 1.3 0 2-1 3.9-1 1.4 0 2.9.8 4 2.1-3.5 1.9-2.9 6.9.1 9.4Z"></path></svg>
          <span><span class="l1">{t('store.l1')}</span><br /><span class="l2">App Store</span></span>
        </a>
      </div>
    </div>
  </div>
</section>

<Footer lang={lang} homeHref={homeHref} policyHref={policyHref} />

<style>
  /* hero */
  .hero {
    padding-top: 130px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -12%;
    left: 50%;
    transform: translateX(-50%);
    width: 130%;
    height: 680px;
    z-index: -1;
    background: radial-gradient(50% 60% at 50% 0%, rgba(241, 104, 38, 0.18), transparent 70%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(40px, 6.2vw, 76px);
    font-weight: 850;
    margin: 18px 0 22px;
  }
  .hero .sub {
    font-size: clamp(17px, 2vw, 21px);
    color: var(--muted);
    max-width: 33ch;
    margin-bottom: 30px;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .fineprint {
    margin-top: 18px;
    font-size: 14px;
    color: var(--dim);
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .fineprint span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .fineprint .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero-visual :global(.iphone) {
    transform: rotate(2.2deg);
  }

  /* trust strip */
  .trust {
    border-block: 1px solid var(--hair);
    background: var(--bg-2);
  }
  .trust .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 40px;
    padding-block: 26px;
  }
  .trust .item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 550;
  }
  .trust .item svg {
    width: 20px;
    height: 20px;
    color: var(--accent-2);
    flex: none;
  }

  /* feature grid */
  .feat-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 56px;
  }
  .feat-head h2 {
    font-size: clamp(30px, 4.4vw, 50px);
    margin-bottom: 16px;
  }
  .feat-head p {
    color: var(--muted);
    font-size: 19px;
  }
  .grid6 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .fcard {
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    padding: 28px 26px 30px;
    transition: border-color 0.25s, transform 0.25s, background 0.25s;
  }
  .fcard:hover {
    border-color: var(--hair-2);
    transform: translateY(-4px);
    background: var(--card-2);
  }
  .fcard .ic {
    width: 50px;
    height: 50px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    margin-bottom: 18px;
    background: rgba(241, 104, 38, 0.13);
    color: var(--accent-2);
  }
  .fcard .ic svg {
    width: 26px;
    height: 26px;
  }
  .fcard h3 {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .fcard p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }
  .fcard.pink .ic {
    background: rgba(225, 69, 106, 0.14);
    color: #ff6f94;
  }
  .fcard.blue .ic {
    background: rgba(63, 125, 240, 0.15);
    color: #7aa2ff;
  }

  /* showcase rows */
  .showcase-bg {
    background: var(--bg-2);
    border-block: 1px solid var(--hair);
  }
  .show {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-bottom: clamp(70px, 9vw, 120px);
  }
  .show:last-child {
    margin-bottom: 0;
  }
  .show.rev .copy {
    order: 2;
  }
  .show .copy .eyebrow {
    margin-bottom: 16px;
  }
  .show .copy h2 {
    font-size: clamp(28px, 3.6vw, 42px);
    margin-bottom: 18px;
  }
  .show .copy p {
    color: var(--muted);
    font-size: 18px;
    max-width: 42ch;
    margin-bottom: 24px;
  }
  .pts {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pts li {
    list-style: none;
    display: flex;
    gap: 13px;
    align-items: flex-start;
    color: #d7d8dc;
    font-size: 16px;
  }
  .pts .chk {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(241, 104, 38, 0.14);
    color: var(--accent-2);
    display: grid;
    place-items: center;
    margin-top: 1px;
  }
  .pts .chk svg {
    width: 14px;
    height: 14px;
  }
  .stage {
    display: flex;
    justify-content: center;
    position: relative;
  }

  /* go-button callout (overlay tag) */
  .tag {
    position: absolute;
    z-index: 4;
    top: 14%;
    right: 6%;
    background: var(--grad);
    color: #1a0c04;
    font-weight: 700;
