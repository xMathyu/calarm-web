---
import { Image } from 'astro:assets';
import appIcon from '../assets/images/app-icon.png';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Phone from './Phone.astro';
import HeroClock from './HeroClock.astro';
import StoreButton from './StoreButton.astro';
import { landing } from '../i18n/landing';
import { pageHref, pageHrefs } from '../i18n/utils';
import { shot } from '../lib/shots';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = landing[lang];
const homeHref = pageHref('home', lang);
const policyHref = pageHref('privacy', lang);
const homeHrefs = pageHrefs('home');
---

<Nav lang={lang} homeHref={homeHref} langHrefs={homeHrefs} onHome />

<main id="top">
  <!-- ================= HERO ================= -->
  <section class="hero" data-hero>
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="badge" data-hero-fade>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C12.6 6.6 17.4 11.4 24 12 17.4 12.6 12.6 17.4 12 24 11.4 17.4 6.6 12.6 0 12 6.6 11.4 11.4 6.6 12 0Z"></path></svg>
          {c.hero.badge}
        </p>
        <h1 data-hero-title class:list={{ long: (c.hero.h1a + c.hero.h1b).length > 38 }}>{c.hero.h1a} <span class="grad">{c.hero.h1b}</span></h1>
        <p class="sub" data-hero-fade>{c.hero.sub}</p>
        <div class="ctas" data-hero-fade>
          <StoreButton line1={c.hero.storeLine1} />
          <a class="ghost" href="#features">
            {c.hero.secondary}
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
          </a>
        </div>
        <ul class="ticks" data-hero-fade>
          {
            c.hero.ticks.map((tick) => (
              <li>
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                {tick}
              </li>
            ))
          }
        </ul>
        {c.appLanguageNote && <p class="langnote" data-hero-fade>{c.appLanguageNote}</p>}
      </div>

      <div class="hero-visual">
        <div class="clock-wrap" data-hero-clock><HeroClock /></div>
        <div class="hero-phone" data-hero-phone>
          <Phone img={shot(lang, 'list')} alt={c.hero.phoneAlt} width={300} eager />
        </div>
        <div class="chip chip-1" data-hero-chip aria-hidden="true">
          <span class="chip-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><circle cx="12" cy="13" r="7"></circle><path d="M12 10v3l2 2M5 4 3 6M19 4l2 2"></path></svg>
          </span>
          <span class="chip-txt"><b>{c.hero.chip1Title}</b><span>{c.hero.chip1Sub}</span></span>
        </div>
        <div class="chip chip-2" data-hero-chip aria-hidden="true">
          <span class="chip-txt"><b>{c.hero.chip2Title}</b><span>{c.hero.chip2Sub}</span></span>
          <span class="join">{c.hero.chip2Button}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= USE CASES ================= -->
  <section class="uses" aria-label={c.usesLabel}>
    <div class="marquee">
      <div class="track" data-marquee>
        <ul>{c.uses.map((u) => <li>{u}</li>)}</ul>
        <ul aria-hidden="true">{c.uses.map((u) => <li>{u}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ================= FEATURE STORIES ================= -->
  <section id="features" class="features">
    {
      c.features.map((f, i) => (
        <article id={f.id} class:list={['feature', 'wrap', { flip: i % 2 === 1 }]} data-feature>
          <div class="copy" data-feature-copy>
            <p class="eyebrow">{f.eyebrow}</p>
            <h2>{f.title}</h2>
            <p class="body">{f.body}</p>
            <ul class="bullets">
              {f.bullets.map((b) => (
                <li>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class:list={['shots', { pair: f.shots.length > 1 }]}>
            <div class="glow" data-glow aria-hidden="true" />
            {f.shots[1] && (
              <div class="back" data-shot-back>
                <Phone img={shot(lang, f.shots[1])} alt={f.alts[1] ?? ''} width={250} />
              </div>
            )}
            <div class="front" data-shot-front>
              <Phone img={shot(lang, f.shots[0])} alt={f.alts[0] ?? ''} width={290} />
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- ================= BENTO ================= -->
  <section class="bento">
    <div class="wrap">
      <h2 data-rise>{c.bento.title}</h2>
      <div class="grid">
        {
          c.bento.items.map((b) => {
            const img = b.shot ? shot(lang, b.shot) : undefined;
            return (
              <div class:list={['card', { media: !!img }]} data-rise>
                <h3>{b.title}</h3>
                <p>{b.body}</p>
                {img && (
                  <div class="peek">
                    <Image src={img} alt={b.alt ?? ''} widths={[300, 600]} sizes="300px" loading="lazy" />
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ================= PRICING ================= -->
  <section id="pricing" class="pricing">
    <div class="wrap">
      <div class="head" data-rise>
        <p class="eyebrow">{c.pricing.eyebrow}</p>
        <h2>{c.pricing.title1}<br /><span class="grad">{c.pricing.title2}</span></h2>
        <p>{c.pricing.body}</p>
      </div>
      <div class="price-grid">
        <div class="plan" data-rise>
          <h3>{c.pricing.free.name}</h3>
          <p class="price"><strong>{c.pricing.free.price}</strong> <span>{c.pricing.free.per}</span></p>
          <ul>
            {
              c.pricing.free.items.map((it) => (
                <li>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  <span>{it}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="plan plus" data-rise>
          <h3><span class="grad">{c.pricing.plus.name}</span></h3>
          <p class="price"><strong>{c.pricing.plus.price}</strong> <span>{c.pricing.plus.per}</span></p>
          <p class="alt">{c.pricing.plus.alt}</p>
          <p class="lead">{c.pricing.plus.lead}</p>
          <ul>
            {
              c.pricing.plus.items.map((it) => (
                <li>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                  <span>{it}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="paywall" data-rise>
          <Phone img={shot(lang, 'paywall')} alt={c.pricing.shotAlt} width={250} />
        </div>
      </div>
      <p class="note" data-rise>{c.pricing.note}</p>
    </div>
  </section>

  <!-- ================= PRIVACY ================= -->
  <section id="privacy" class="privacy">
    <div class="wrap" data-rise>
      <div class="lock" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="11" width="16" height="10" rx="2.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path><circle cx="12" cy="16" r="1.3" fill="currentColor"></circle></svg>
      </div>
      <h2>{c.privacy.title}</h2>
      <p>{c.privacy.body}</p>
      <a class="ghost" href={policyHref}>{c.privacy.link}</a>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section class="final">
    <div class="wrap">
      <div class="box">
        <div class="cta-icon" data-cta-icon>
          <Image src={appIcon} alt="" width={144} height={144} />
        </div>
        <h2>{c.cta.title}</h2>
        <p>{c.cta.sub}</p>
        <StoreButton line1={c.hero.storeLine1} />
      </div>
    </div>
  </section>
</main>

<Footer lang={lang} homeHref={homeHref} policyHref={policyHref} homeHrefs={homeHrefs} />

<script>
  import { initMotion } from '../lib/motion';
  initMotion();
</script>

<style>
  main {
    overflow-x: clip;
  }
  .grad {
    background: linear-gradient(100deg, #ffb07a 0%, #ff6a2b 55%, #ee4e1b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* SplitText wraps each word (and a mask around it): the gradient has to be
     painted on the word itself, or the transparent text shows nothing. */
  .grad :global(.word) {
    background: linear-gradient(100deg, #ffb07a 0%, #ff6a2b 60%, #ee4e1b 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }
  .eyebrow {
    color: var(--accent-2);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 56px;
    padding: 0 22px;
    border-radius: 16px;
    border: 1px solid var(--hair-2);
    color: var(--ink);
    font-weight: 600;
    transition: background 0.2s;
  }
  .ghost:hover {
    background: var(--card);
  }
  .ghost svg {
    width: 16px;
    height: 16px;
  }

  /* ---------- hero ---------- */
  .hero {
    position: relative;
    padding: 132px 0 80px;
  }
  .hero-bg {
    position: absolute;
    inset: -120px 0 auto;
    height: 1000px;
    background:
      radial-gradient(45% 45% at 72% 38%, rgba(255, 106, 43, 0.3), transparent 70%),
      radial-gradient(35% 35% at 15% 10%, rgba(255, 154, 94, 0.1), transparent 70%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 48px;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 122, 61, 0.12);
    border: 1px solid rgba(255, 122, 61, 0.3);
    color: #ffb48a;
    font-size: 14px;
    font-weight: 600;
  }
  .badge svg {
    width: 14px;
    height: 14px;
  }
  h1 {
    font-size: clamp(46px, 6.3vw, 90px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  /* Longer headlines (pt, de) would run to five lines at full size. */
  h1.long {
    font-size: clamp(42px, 5.2vw, 74px);
  }
  .sub {
    max-width: 33em;
    font-size: clamp(18px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .ticks {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 500;
  }
  .ticks li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ticks svg {
    width: 16px;
    height: 16px;
    color: var(--accent-2);
  }
  .langnote {
    color: var(--dim);
    font-size: 14px;
  }
  .hero-visual {
    position: relative;
    height: 660px;
  }
  .clock-wrap {
    position: absolute;
    left: -6%;
    top: -2%;
    width: 64%;
    z-index: 1;
  }
  .hero-phone {
    position: absolute;
    right: 4%;
    top: 0;
    z-index: 2;
  }
  .chip {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 20px;
    background: rgba(30, 23, 20, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .chip-1 {
    left: 0;
    bottom: 130px;
  }
  .chip-2 {
    right: 0;
    bottom: 28px;
    padding-left: 18px;
  }
  .chip-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, #ffa066, #ee4e1b);
    display: grid;
    place-items: center;
  }
  .chip-icon svg {
    width: 22px;
    height: 22px;
  }
  .chip-txt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    color: var(--muted);
  }
  .chip-txt b {
    color: var(--ink);
    font-size: 15px;
  }
  .join {
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--accent-3);
    color: #1a0c04;
    font-weight: 700;
    font-size: 14px;
  }

  /* ---------- use cases ---------- */
  .uses {
    padding: 10px 0 40px;
  }
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
  }
  .track ul {
    list-style: none;
    display: flex;
    gap: 12px;
    padding-right: 12px;
  }
  .track li {
    white-space: nowrap;
    padding: 14px 22px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--hair);
    font-weight: 600;
    font-size: 16px;
    color: #e6dad3;
  }

  /* ---------- feature stories ---------- */
  .features {
    padding: 90px 0 40px;
    display: flex;
    flex-direction: column;
    gap: 140px;
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    scroll-margin-top: 90px;
  }
  .feature.flip .copy {
    order: 2;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 520px;
  }
  .feature.flip .copy {
    justify-self: end;
  }
  .copy h2 {
    font-size: clamp(36px, 4.4vw, 60px);
  }
  .body {
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
  }
  .bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 6px;
    color: #e6dad3;
    font-size: 16px;
  }
  .bullets li {
    display: flex;
    gap: 12px;
  }
  .bullets svg {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    color: var(--accent-2);
  }
  .shots {
    position: relative;
    display: flex;
    justify-content: center;
    min-height: 640px;
    align-items: center;
  }
  .shots.pair .front {
    transform: translateX(-16%);
  }
  .glow {
    position: absolute;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 106, 43, 0.28), transparent 65%);
    filter: blur(10px);
  }
  .front {
    position: relative;
    z-index: 2;
  }
  .back {
    position: absolute;
    z-index: 1;
    right: 4%;
    top: 4%;
    opacity: 0.92;
  }

  /* ---------- bento ---------- */
  .bento {
    padding: 120px 0 80px;
  }
  .bento h2 {
    text-align: center;
    font-size: clamp(34px, 4.2vw, 56px);
    max-width: 16em;
    margin: 0 auto 48px;
  }
  .bento .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 16px;
  }
  .card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px;
    border-radius: 28px;
    background: var(--card);
    border: 1px solid var(--hair);
    transition: border-color 0.3s, transform 0.3s;
  }
  .card:hover {
    border-color: rgba(255, 122, 61, 0.4);
    transform: translateY(-3px);
  }
  .card.media {
    grid-row: span 2;
    padding-bottom: 0;
    background: linear-gradient(180deg, var(--card) 40%, #22150f);
  }
  .card h3 {
    font-size: 22px;
    font-weight: 800;
  }
  .card p {
    color: var(--muted);
    line-height: 1.55;
    font-size: 15px;
  }
  .peek {
    margin: 18px auto 0;
    width: 82%;
    height: 280px;
    overflow: hidden;
    border-radius: 26px 26px 0 0;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.4);
  }
  .peek :global(img) {
    width: 100%;
    height: auto;
  }

  /* ---------- pricing ---------- */
  .pricing {
    padding: 120px 0;
    background: linear-gradient(180deg, var(--bg), #150d0a 45%, var(--bg));
    scroll-margin-top: 60px;
  }
  .pricing .head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 48px;
  }
  .pricing h2 {
    font-size: clamp(36px, 4.6vw, 62px);
  }
  .pricing .head > p:last-child {
    max-width: 36em;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.55;
  }
  .price-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 18px;
    align-items: stretch;
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px;
    border-radius: 28px;
    background: var(--card);
    border: 1px solid var(--hair);
  }
  .plan.plus {
    background: linear-gradient(180deg, rgba(255, 106, 43, 0.16), var(--card) 60%);
    border-color: rgba(255, 122, 61, 0.5);
  }
  .plan h3 {
    font-size: 24px;
    font-weight: 800;
  }
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    color: var(--muted);
  }
  .price strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 46px;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .alt {
    color: var(--muted);
  }
  .lead {
    margin-top: 6px;
    font-weight: 700;
  }
  .plan ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 6px;
    color: #e6dad3;
  }
  .plan li {
    display: flex;
    gap: 10px;
    line-height: 1.45;
  }
  .plan li svg {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    color: var(--accent-2);
  }
  .paywall {
    display: flex;
    align-items: center;
  }
  .note {
    margin: 26px auto 0;
    max-width: 72ch;
    text-align: center;
    color: var(--dim);
    font-size: 13px;
    line-height: 1.6;
  }

  /* ---------- privacy ---------- */
  .privacy {
    padding: 120px 0;
    text-align: center;
    scroll-margin-top: 60px;
  }
  .privacy .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .lock {
    width: 74px;
    height: 74px;
    border-radius: 20px;
    background: rgba(255, 122, 61, 0.13);
    color: var(--accent-2);
    display: grid;
    place-items: center;
  }
  .lock svg {
    width: 38px;
    height: 38px;
  }
  .privacy h2 {
    font-size: clamp(36px, 4.6vw, 62px);
  }
  .privacy p {
    max-width: 34em;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }

  /* ---------- final ---------- */
  .final {
    padding: 40px 0 120px;
  }
  .final .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 72px 32px;
    border-radius: 44px;
    text-align: center;
    background: radial-gradient(70% 90% at 50% 100%, rgba(255, 106, 43, 0.35), var(--card) 70%);
    border: 1px solid rgba(255, 122, 61, 0.3);
  }
  .cta-icon :global(img) {
    width: 132px;
    height: 132px;
    border-radius: 30px;
    box-shadow: 0 30px 80px rgba(238, 78, 27, 0.5);
  }
  .final h2 {
    font-size: clamp(36px, 5vw, 66px);
  }
  .final p {
    color: var(--muted);
    font-size: 18px;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1020px) {
    .hero-grid,
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }
    .feature.flip .copy {
      order: 0;
      justify-self: start;
    }
    .hero-visual {
      height: 620px;
      max-width: 540px;
      width: 100%;
      margin: 0 auto;
    }
    .bento .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
