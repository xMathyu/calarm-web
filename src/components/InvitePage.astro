---
/**
 * Invitation landing page — what someone sees when they tap a Calarmi invite,
 * to an alarm (`/i/`) or to a countdown (`/c/`).
 *
 * On a device with Calarmi installed this page is never drawn: the universal
 * link hands the URL straight to the app. It exists for everyone else, so it is
 * written as a shop window rather than a notice: the alarm (or the countdown)
 * itself is the hero, and the App Store button is the only real action.
 *
 * It also feeds the link-preview crawlers (iMessage, WhatsApp, Telegram,
 * Slack), which is why the name and the date live in the OG tags too.
 *
 * The page routes decode the link and set the status; this draws it.
 */
import Layout from '../layouts/Layout.astro';
import {
  daysUntil,
  formatCountdownDay,
  formatDay,
  formatTime,
  formatWhen,
  PHOTO_PARAM,
  type InvitePayload,
} from '../lib/invite';
import { ALARM_CLOCK_GLYPH, HOURGLASS_GLYPH, glyphFor } from '../lib/icons';
import { APP_STORE_URL, APP_STORE_ID } from '../lib/appStore';

interface Props {
  /** The decoded link, or null for a malformed one. */
  invite: InvitePayload | null;
  /** The link's raw data segment, passed on to the card and the app. */
  data: string;
  /** Which door the link came through: `i` alarms, `c` countdowns. */
  path: 'i' | 'c';
  /** The photo carried in `?f=`, already validated. */
  photo?: Buffer;
}

const { invite, data, path, photo } = Astro.props;
const isCountdown = path === 'c';

const lang = invite?.l ?? 'es';
const tint = invite?.c ?? '#f16826';

const pt = {
  eyebrow: isCountdown ? 'Convite para uma contagem regressiva' : 'Convite para um alarme',
  description: (w: string) =>
    isCountdown
      ? `${w} · Abra no Calarmi para acompanhar a contagem regressiva.`
      : `${w} · Abra no Calarmi para que ele toque também no seu iPhone.`,
  storeLine1: 'Baixar na',
  openApp: 'Já tenho o Calarmi',
  hint: isCountdown
    ? 'Acabou de instalar? Toque no link de novo e a contagem regressiva é adicionada sozinha.'
    : 'Acabou de instalar? Toque no link de novo e o alarme é adicionado sozinho.',
  pitch: isCountdown
    ? 'Conta os dias que faltam, com foto e widgets para a Tela de Início.'
    : 'Toca mesmo no silencioso, com a tela bloqueada ou em Foco.',
  free: 'Grátis · Sem conta · Sem configurar nada',
  badTitle: 'Este convite não é mais válido',
  badBody: 'O link está incompleto ou foi modificado. Peça para quem te convidou enviar de novo.',
  badCta: 'Conhecer o Calarmi',
  today: 'Hoje!',
  unit: (n: number) => (n === 1 ? 'dia' : 'dias'),
  ago: (n: number) => (n === 1 ? 'dia atrás' : 'dias atrás'),
};

const copy =
  lang === 'pt'
    ? pt
    : lang === 'en'
    ? {
        eyebrow: isCountdown ? 'Countdown invitation' : 'Alarm invitation',
        description: (w: string) =>
          isCountdown
            ? `${w} · Open it in Calarmi to follow the countdown.`
            : `${w} · Open it in Calarmi so it rings on your iPhone too.`,
        storeLine1: 'Download on the',
        openApp: 'I already have Calarmi',
        hint: isCountdown
          ? 'Installed it just now? Tap the link again and the countdown adds itself.'
          : 'Installed it just now? Tap the link again and the alarm adds itself.',
        pitch: isCountdown
          ? 'Counts down the days, with a photo and Home Screen widgets.'
          : 'Rings even on silent, locked or in Focus.',
        free: 'Free · No account · Nothing to configure',
        badTitle: 'This invitation is no longer valid',
        badBody: 'The link is incomplete or has been modified. Ask whoever invited you to send it again.',
        badCta: 'Learn about Calarmi',
        today: 'Today!',
        unit: (n: number) => (n === 1 ? 'day left' : 'days left'),
        ago: (n: number) => (n === 1 ? 'day ago' : 'days ago'),
      }
    : {
        eyebrow: isCountdown ? 'Invitación a una cuenta regresiva' : 'Invitación a una alarma',
        description: (w: string) =>
          isCountdown
            ? `${w} · Ábrela en Calarmi para seguir la cuenta regresiva.`
            : `${w} · Ábrela en Calarmi para que también suene en tu iPhone.`,
        storeLine1: 'Descargar en',
        openApp: 'Ya tengo Calarmi',
        hint: isCountdown
          ? '¿La acabas de instalar? Vuelve a tocar el enlace y la cuenta regresiva se añade sola.'
          : '¿La acabas de instalar? Vuelve a tocar el enlace y la alarma se añade sola.',
        pitch: isCountdown
          ? 'Cuenta los días que faltan, con foto y widgets para tu pantalla de inicio.'
          : 'Suena aunque el iPhone esté en silencio, bloqueado o en Concentración.',
        free: 'Gratis · Sin cuenta · Sin configurar nada',
        badTitle: 'Esta invitación ya no es válida',
        badBody: 'El enlace está incompleto o se ha modificado. Pídele a quien te invitó que te lo mande otra vez.',
        badCta: 'Conocer Calarmi',
        today: '¡Hoy!',
        unit: (n: number) => (n === 1 ? 'día' : 'días'),
        ago: (n: number) => (n === 1 ? 'día atrás' : 'días atrás'),
      };

// A countdown leads with the days left, the way the app shows it.
const days = invite && isCountdown ? daysUntil(invite) : 0;
const counterNumber = days === 0 ? '' : String(Math.abs(days));
const counterUnit = days === 0 ? copy.today : days > 0 ? copy.unit(days) : copy.ago(-days);
const countdownLine = days === 0 ? copy.today : `${Math.abs(days)} ${counterUnit}`;

const title = invite ? invite.t : copy.badTitle;
const description = invite
  ? copy.description(isCountdown ? `${countdownLine} · ${formatCountdownDay(invite)}` : formatWhen(invite))
  : copy.badBody;

// Built from `site` rather than `Astro.url.href`: on Vercel the request URL's
// host arrives as `localhost`.
const inviteUrl = new URL(Astro.url.pathname, Astro.site).href;
const appBanner = `app-id=${APP_STORE_ID}, app-argument=${inviteUrl}`;

// Second door into the app. A universal link can't be triggered from a page on
// the very domain it belongs to — iOS deliberately ignores that — so "I already
// have Calarmi" has to go through the custom scheme instead.
const appSchemeUrl = `calarm://${path}/${data}/`;

// The tile shows the alarm's own icon when it isn't an emoji: the look-alike
// of the sender's SF Symbol, or the alarm clock (an hourglass for a countdown)
// for one the site can't draw.
const fallbackGlyph = isCountdown ? HOURGLASS_GLYPH : ALARM_CLOCK_GLYPH;
const glyph = invite ? (glyphFor(invite.y) ?? fallbackGlyph) : fallbackGlyph;

// The photo, when the link carries one: it fills the tile here and on the
// preview card, which gets it through the same query parameter.
const photoSrc = photo ? `data:image/jpeg;base64,${photo.toString('base64')}` : undefined;
const cardQuery = photo ? `?${PHOTO_PARAM}=${photo.toString('base64url')}` : '';
---

<Layout
  lang={lang === 'en' ? 'en' : 'es'}
  htmlLang={lang === 'pt' ? 'pt-BR' : undefined}
  title={title}
  description={description}
  ogImage={invite ? `/card/${data}/${cardQuery}` : '/og-image.png'}
  noindex={true}
  appBanner={appBanner}
>
  <main class="invite" style={`--tint:${tint}`}>
    <a class="brand" href={lang === 'en' ? '/en/' : '/'}>
      <img src="/assets/app-icon.png" alt="" width="34" height="34" />
      <span>Calarmi</span>
    </a>

    <div class="card">
      <p class="eyebrow">{invite ? copy.eyebrow : 'Calarmi'}</p>

      {
        invite ? (
          <>
            <div class="tile" aria-hidden="true">
              {photoSrc ? (
                <img class="photo" src={photoSrc} alt="" width="92" height="92" />
              ) : invite.e ? (
                <span class="emoji">{invite.e}</span>
              ) : (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#fff"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={glyph}
                />
              )}
            </div>

            <h1>{invite.t}</h1>
            {isCountdown ? (
              <>
                <p class="count">
                  {counterNumber && <span class="count-number">{counterNumber}</span>}
                  <span class="count-unit">{counterUnit}</span>
                </p>
                <p class="day">{formatCountdownDay(invite)}</p>
              </>
            ) : (
              <>
                <p class="day">{formatDay(invite)}</p>
                <p class="time">{formatTime(invite)}</p>
              </>
            )}
          </>
        ) : (
          <>
            <h1 class="bad">{copy.badTitle}</h1>
            <p class="day">{copy.badBody}</p>
          </>
        )
      }

      <div class="actions">
        <a class="store-btn" href={APP_STORE_URL}>
          <svg viewBox="0 0 24 24" fill="currentColor"
            ><path
              d="M16.5 1.6c.1 1-.3 2-1 2.8-.7.8-1.8 1.4-2.8 1.3-.1-1 .4-2 1-2.7.7-.8 1.9-1.4 2.8-1.4ZM19.9 17c-.5 1.2-.8 1.7-1.4 2.8-1 1.5-2.3 3.4-4 3.4-1.5 0-1.9-1-3.9-1-2 0-2.5 1-4 1-1.6 0-2.9-1.7-3.8-3.2-2.6-4-2.9-8.8-1.3-11.3C2.7 6.6 4.4 5.5 6 5.5c1.6 0 2.6 1 3.9 1 1.3 0 2-1 3.9-1 1.4 0 2.9.8 4 2.1-3.5 1.9-2.9 6.9.1 9.4Z"
            ></path></svg
          >
          <span
            ><span class="l1">{invite ? copy.storeLine1 : ''}</span><br /><span class="l2"
              >{invite ? 'App Store' : copy.badCta}</span
            ></span
          >
        </a>

        {invite && <a class="open-app" href={appSchemeUrl}>{copy.openApp}</a>}
      </div>

      {invite && <p class="pitch">{copy.pitch}</p>}
    </div>

    {invite && <p class="hint">{copy.hint}</p>}
    {invite && <p class="free">{copy.free}</p>}
  </main>
</Layout>

<style>
  .invite {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 28px 16px 40px;
    background:
      radial-gradient(70rem 34rem at 50% -6%, color-mix(in srgb, var(--tint) 30%, transparent), transparent 68%),
      var(--bg);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 4px;
    color: var(--ink);
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .brand img {
    border-radius: 8px;
  }

  .card {
    width: min(100%, 420px);
    text-align: center;
    padding: 34px 26px 30px;
    background: linear-gradient(180deg, var(--card-2), var(--card));
    border: 1px solid var(--hair);
    border-radius: var(--r-lg);
    box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.9);
  }

  .eyebrow {
    color: var(--tint);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* The same tinted tile the app draws as a shared alarm's avatar. */
  .tile {
    width: 92px;
    height: 92px;
    margin: 22px auto 20px;
    display: grid;
    place-items: center;
    border-radius: 24px;
    background: linear-gradient(135deg, var(--tint), color-mix(in srgb, var(--tint) 72%, transparent));
    box-shadow: 0 16px 34px -16px var(--tint);
  }
  .tile svg {
    width: 50px;
    height: 50px;
  }
  /* The photo fills the tile, cropped like the app's avatar. */
  .tile .photo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: inherit;
  }
  .emoji {
    font-size: 46px;
    line-height: 1;
  }

  h1 {
    font-size: clamp(25px, 6.5vw, 31px);
    line-height: 1.18;
    letter-spacing: -0.022em;
    color: var(--ink);
    /* Long alarm names wrap instead of pushing the card sideways. */
    overflow-wrap: anywhere;
  }
  h1.bad {
    margin-top: 10px;
  }

  .day {
    margin-top: 10px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .time {
    margin-top: 2px;
    font-size: 40px;
    font-weight: 660;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* A countdown's big number, like the app's card: the days, then the unit. */
  .count {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--ink);
  }
  .count-number {
    font-size: 64px;
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .count-unit {
    margin-top: 4px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tint);
  }

  .actions {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  /* `.store-btn` itself is the shared one from the landing page. */
  .actions :global(.store-btn) {
    text-decoration: none;
  }

  .open-app {
    color: var(--muted);
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid var(--hair-2);
    padding-bottom: 2px;
  }
  .open-app:hover {
    color: var(--ink);
  }

  .pitch {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--hair);
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .hint {
    max-width: 380px;
    color: var(--dim);
    font-size: 13px;
    line-height: 1.55;
    text-align: center;
  }

  .free {
    color: var(--dim);
    font-size: 12px;
    letter-spacing: 0.01em;
  }
</style>
