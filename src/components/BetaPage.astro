---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import StoreButton from './StoreButton.astro';
import { beta } from '../i18n/beta';
import { help } from '../i18n/help';
import { landing } from '../i18n/landing';
import { pageHref, pageHrefs, routes, localizedPath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { PLAY_TESTING_URL, PLAY_URL, TESTERS_GROUP_URL } from '../lib/playStore';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = beta[lang];
const h = help[lang];
const homeHref = pageHref('home', lang);
const site = (Astro.site ?? new URL('https://calarmi.mathyusolutions.com')).origin;

// One button per step, in order: join the group, opt in on Play, install.
// Inner markup of 24×24 Lucide glyphs (ISC), the same family the site uses.
const steps = c.steps.map((s, i) => ({
  ...s,
  href: [TESTERS_GROUP_URL, PLAY_TESTING_URL, PLAY_URL][i],
  icon: [
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
    '<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',
  ][i],
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Calarmi', item: `${site}${localizedPath(lang, '')}` },
    { '@type': 'ListItem', position: 2, name: c.eyebrow, item: `${site}${localizedPath(lang, routes.beta[lang])}` },
  ],
};
---

<Layout lang={lang} title={c.metaTitle} description={c.metaDescription} path={routes.beta[lang]} alternates={routes.beta} jsonLd={jsonLd}>
  <Nav lang={lang} homeHref={homeHref} langHrefs={pageHrefs('beta')} />
  <main class="wrap beta">
    <header>
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </header>

    <p class="tip">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"></rect><path d="M12 18h.01"></path></svg>
      <span><b>{c.tipLead}</b> {c.tip}</span>
    </p>

    <section aria-labelledby="steps-title">
      <h2 id="steps-title">{c.stepsTitle}</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="num" aria-hidden="true">{i + 1}</span>
              <div class="step-copy">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <a class="primary" href={s.href} target="_blank" rel="noopener">
                  <svg class="glyph" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
                  <span>{s.cta}</span>
                  <svg class="out" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="notes" aria-labelledby="notes-title">
      <h2 id="notes-title">{c.notesTitle}</h2>
      <div class="note-grid">
        {
          c.notes.map((n) => (
            <div class="note">
              <h3>{n.q}</h3>
              <p set:html={n.a} />
            </div>
          ))
        }
        <div class="note ios">
          <div>
            <h3>{c.iphoneQ}</h3>
            <p>{c.iphoneA}</p>
          </div>
          <StoreButton line1={landing[lang].hero.storeLine1} />
        </div>
      </div>
    </section>

    <p class="links">
      <a href={pageHref('help', lang)}>{h.title}</a>
      <span aria-hidden="true">·</span>
      <a href={pageHref('privacy', lang)}>{h.privacyLink}</a>
      <span aria-hidden="true">·</span>
      <a href={homeHref}>{h.back}</a>
    </p>
  </main>
  <Footer lang={lang} homeHref={homeHref} policyHref={pageHref('privacy', lang)} homeHrefs={pageHrefs('home')} />
</Layout>

<style>
  .beta {
    max-width: 860px;
    padding-top: 140px;
    padding-bottom: 100px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .eyebrow {
    color: var(--accent-2);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 68px);
  }
  .lead {
    margin-top: 14px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.55;
  }
  .tip {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px 22px;
    border-radius: 20px;
    background: rgba(255, 122, 61, 0.1);
    border: 1px solid rgba(255, 122, 61, 0.35);
    color: var(--muted);
    line-height: 1.55;
  }
  .tip svg {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    color: var(--accent-2);
  }
  .tip b {
    color: var(--ink);
  }
  section h2 {
    font-size: 30px;
    margin-bottom: 18px;
  }
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .step {
    display: flex;
    gap: 20px;
    padding: 28px;
    border-radius: 28px;
    background: var(--card);
    border: 1px solid var(--hair);
  }
  .num {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--grad);
    color: #1a0c04;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 24px;
    box-shadow: 0 10px 30px -8px rgba(241, 104, 38, 0.55);
  }
  .step-copy {
    min-width: 0;
  }
  .step h3 {
    font-size: 24px;
    line-height: 1.15;
    margin-top: 10px;
  }
  .step p {
    margin-top: 8px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 62ch;
  }
  .primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 54px;
    margin-top: 18px;
    padding: 0 20px;
    border-radius: 16px;
    background: var(--grad);
    color: #1a0c04;
    font-weight: 700;
    font-size: 16px;
    box-shadow: 0 10px 30px -8px rgba(241, 104, 38, 0.55);
    transition: transform 0.2s, filter 0.2s;
  }
  .primary:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
  .primary svg {
    flex: none;
  }
  .glyph {
    width: 20px;
    height: 20px;
  }
  .out {
    width: 16px;
    height: 16px;
    opacity: 0.7;
  }
  .note-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .note {
    padding: 22px 24px;
    border-radius: 22px;
    background: var(--card);
    border: 1px solid var(--hair);
  }
  .note h3 {
    font-size: 19px;
    line-height: 1.2;
  }
  .note p {
    margin-top: 8px;
    color: var(--muted);
    line-height: 1.6;
    font-size: 16px;
  }
  .note p :global(a) {
    color: var(--accent-2);
    overflow-wrap: anywhere;
  }
  .ios {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px 24px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--dim);
  }
  .links a {
    color: var(--accent-2);
  }
  @media (max-width: 640px) {
    .note-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .step {
      flex-direction: column;
      gap: 14px;
      padding: 22px;
    }
    .step h3 {
      margin-top: 0;
    }
    .primary {
      display: flex;
      justify-content: center;
      width: 100%;
    }
  }
</style>
