---
import { Image } from 'astro:assets';
import appIcon from '../assets/images/app-icon.png';
import { useTranslations, allLangs } from '../i18n/utils';
import { landing } from '../i18n/landing';
import { languages, localeTags, type Lang } from '../i18n/ui';
import { APP_STORE_URL } from '../lib/appStore';

interface Props {
  lang: Lang;
  homeHref: string;
  policyHref: string;
  /** The home page in every locale. */
  homeHrefs: Record<Lang, string>;
}
const { lang, homeHref, policyHref, homeHrefs } = Astro.props;
const t = useTranslations(lang);
const copy = landing[lang];
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href={homeHref} class="brand" aria-label="Calarmi">
          <Image src={appIcon} alt="" width={72} height={72} />
          <span class="wordmark" aria-hidden="true">calarm<span class="i">i</span></span>
        </a>
        <p>{t('foot.tag')}</p>
      </div>
      <div class="foot-cols">
        <div class="foot-col">
          <h2>{t('foot.product')}</h2>
          <a href={`${homeHref}#features`}>{t('foot.features')}</a>
          <a href={`${homeHref}#pricing`}>{t('nav.pricing')}</a>
          <a href={APP_STORE_URL} target="_blank" rel="noopener">App Store</a>
        </div>
        <div class="foot-col">
          <h2>{t('foot.support')}</h2>
          <a href="mailto:xmathyu@gmail.com">xmathyu@gmail.com</a>
          <a href="https://github.com/xMathyu/Calarm/issues" target="_blank" rel="noopener">{t('foot.issues')}</a>
          <a href={policyHref}>{t('foot.policy')}</a>
        </div>
        <nav class="foot-col" aria-label={copy.footer.languages}>
          <h2>{copy.footer.languages}</h2>
          {
            allLangs.map((l) => (
              <a href={homeHrefs[l]} hreflang={localeTags[l]} lang={localeTags[l]} aria-current={l === lang ? 'true' : undefined}>
                {languages[l]}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 Mathyu Solutions · Calarmi</span>
      <span>{t('foot.made')}</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--hair);
    padding-block: 56px 40px;
  }
  .foot-grid {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .foot-brand {
    max-width: 340px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .brand :global(img) {
    width: 40px;
    height: 40px;
    border-radius: 10px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 26px;
    letter-spacing: -0.03em;
  }
  .wordmark .i {
    color: var(--accent-3);
  }
  .foot-brand p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .foot-cols {
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
  }
  .foot-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .foot-col h2 {
    font-family: var(--font);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 8px;
  }
  .foot-col a {
    color: var(--muted);
    font-size: 15px;
    padding: 5px 0;
  }
  .foot-col a:hover,
  .foot-col a[aria-current] {
    color: var(--ink);
  }
  .foot-bottom {
    margin-top: 44px;
    padding-top: 22px;
    border-top: 1px solid var(--hair);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--dim);
    font-size: 13px;
  }
</style>
