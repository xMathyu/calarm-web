---
import { Image } from 'astro:assets';
import appIcon from '../assets/images/app-icon.png';
import LangMenu from './LangMenu.astro';
import { useTranslations, pageHref, pageHrefs } from '../i18n/utils';
import type { Lang, UIKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

/** iPhone table rows: data type, use, and whether it's linked to you. Tracking is always "No". */
const iosRows: [UIKey, UIKey, boolean][] = [
  ['pv.r1c1', 'pv.r1c2', false],
  ['pv.r2c1', 'pv.r2c2', false],
  ['pv.r4c1', 'pv.r4c2', true],
  ['pv.r5c1', 'pv.r5c2', true],
  ['pv.r6c1', 'pv.r6c2', true],
  ['pv.r7c1', 'pv.r7c2', true],
];

/** Android table rows: data type, use, and whether it leaves the phone. Tracking is always "No". */
const androidRows: [UIKey, UIKey, UIKey][] = [
  ['pv.and_r1c1', 'pv.and_r1c2', 'pv.and_c3_backup'],
  ['pv.and_r2c1', 'pv.and_r2c2', 'pv.no'],
  ['pv.and_r3c1', 'pv.and_r3c2', 'pv.no'],
  ['pv.and_r4c1', 'pv.and_r4c2', 'pv.no'],
  ['pv.and_r5c1', 'pv.and_r5c2', 'pv.and_c3_google'],
  ['pv.and_r6c1', 'pv.and_r6c2', 'pv.and_c3_play'],
  ['pv.and_r7c1', 'pv.and_r7c2', 'pv.and_c3_fb'],
  ['pv.and_r8c1', 'pv.and_r8c2', 'pv.and_c3_fb'],
  ['pv.and_r9c1', 'pv.and_r9c2', 'pv.and_c3_fb'],
  ['pv.and_r10c1', 'pv.and_r10c2', 'pv.and_c3_fb'],
];
/** "Leaves the phone" cells that read as a no, dimmed like the iPhone table's. */
const staysOnPhone = new Set<UIKey>(['pv.no', 'pv.and_c3_backup']);

const sharedItems: UIKey[] = ['pv.s4_li1', 'pv.s4_li2', 'pv.s4_li3', 'pv.s4_li4'];
const androidPermissions: UIKey[] = ['pv.and_perm_li1', 'pv.and_perm_li2', 'pv.and_perm_li3', 'pv.and_perm_li4', 'pv.and_perm_li5'];
const deleteSteps: UIKey[] = ['pv.del_li1', 'pv.del_li2', 'pv.del_li3'];

const homeHref = pageHref('home', lang);
const langHrefs = pageHrefs('privacy');
---

<nav class="nav">
  <div class="wrap row">
    <a href={homeHref} class="brand">
      <Image src={appIcon} alt="Calarmi" width={64} height={64} loading="eager" /> Calarmi
    </a>
    <div class="spacer"></div>
    <LangMenu lang={lang} hrefs={langHrefs} label={t('nav.language')} />
    <a href={homeHref} class="back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span>{t('pv.back')}</span>
    </a>
  </div>
</nav>

<main class="doc">
  <div class="doc-head">
    <span class="eyebrow">{t('pv.ey')}</span>
    <h1>{t('pv.title')}</h1>
    <p class="lead">{t('pv.lead')}</p>
    <p class="updated">{t('pv.updated')}</p>
  </div>

  <div class="tldr">
    <h2>{t('pv.tldr_h')}</h2>
    <ul>
      <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('pv.tldr1')}</span></li>
      <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('pv.tldr2')}</span></li>
      <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('pv.tldr3')}</span></li>
      <li><span class="chk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><span>{t('pv.tldr4')}</span></li>
    </ul>
  </div>

  <section id="access">
    <h2 class="sh">{t('pv.s1_h')}</h2>
    <p>{t('pv.s1_p')}</p>
    <h3>{t('pv.s1a_h')}</h3>
    <p set:html={t('pv.s1a_p')} />
    <h3>{t('pv.s1b_h')}</h3>
    <p set:html={t('pv.s1b_p')} />
    <h3>{t('pv.s1c_h')}</h3>
    <p>{t('pv.s1c_p')}</p>
    <h3>{t('pv.s1d_h')}</h3>
    <p>{t('pv.s1d_p')}</p>
  </section>

  <section id="practices">
    <h2 class="sh">{t('pv.s2_h')}</h2>
    <p>{t('pv.s2_p')}</p>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th>{t('pv.th1')}</th><th>{t('pv.th2')}</th><th>{t('pv.th3')}</th><th>{t('pv.th4')}</th></tr>
        </thead>
        <tbody>
          {iosRows.map(([type, use, linked]) => (
            <tr><td>{t(type)}</td><td>{t(use)}</td><td class={linked ? undefined : 'no'}>{t(linked ? 'pv.yes' : 'pv.no')}</td><td class="no">{t('pv.no')}</td></tr>
          ))}
          <tr><td>{t('pv.r3c1')}</td><td class="no">{t('pv.r3c2')}</td><td class="no">{t('pv.no')}</td><td class="no">{t('pv.no')}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="storage">
    <h2 class="sh">{t('pv.s3_h')}</h2>
    <p>{t('pv.s3_p')}</p>
    <div class="callout">
      <p>{t('pv.s3_callout')}</p>
    </div>
  </section>

  <section id="sharing">
    <h2 class="sh">{t('pv.s4_h')}</h2>
    <p>{t('pv.s4_p')}</p>
    <ul class="list">
      {sharedItems.map((key) => <li set:html={t(key)} />)}
    </ul>
    <p set:html={t('pv.s4_p2')} />
    <p set:html={t('pv.s4_p3')} />
  </section>

  <section id="android">
    <h2 class="sh">{t('pv.and_h')}</h2>
    <p>{t('pv.and_p')}</p>
    <h3>{t('pv.and_store_h')}</h3>
    <p>{t('pv.and_store_p')}</p>
    <h3>{t('pv.and_perm_h')}</h3>
    <p>{t('pv.and_perm_p')}</p>
    <ul class="list">
      {androidPermissions.map((key) => <li set:html={t(key)} />)}
    </ul>
    <h3>{t('pv.and_ai_h')}</h3>
    <p>{t('pv.and_ai_p')}</p>
    <h3>{t('pv.and_diag_h')}</h3>
    <p set:html={t('pv.and_diag_p')} />
    <h3>{t('pv.and_backup_h')}</h3>
    <p>{t('pv.and_backup_p')}</p>
    <h3>{t('pv.and_buy_h')}</h3>
    <p set:html={t('pv.and_buy_p')} />
    <h3>{t('pv.and_not_h')}</h3>
    <p>{t('pv.and_not_p')}</p>
    <h3>{t('pv.and_tbl_h')}</h3>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr><th>{t('pv.th1')}</th><th>{t('pv.th2')}</th><th>{t('pv.and_th3')}</th><th>{t('pv.th4')}</th></tr>
        </thead>
        <tbody>
          {androidRows.map(([type, use, leaves]) => (
            <tr><td>{t(type)}</td><td>{t(use)}</td><td class={staysOnPhone.has(leaves) ? 'no' : undefined}>{t(leaves)}</td><td class="no">{t('pv.no')}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="delete-data">
    <h2 class="sh">{t('pv.del_h')}</h2>
    <p>{t('pv.del_p')}</p>
    <ol class="steps">
      {deleteSteps.map((key) => <li set:html={t(key)} />)}
    </ol>
    <p>{t('pv.del_device_p')}</p>
  </section>

  <section id="children">
    <h2 class="sh">{t('pv.s5_h')}</h2>
    <p>{t('pv.s5_p')}</p>
  </section>

  <section id="changes">
    <h2 class="sh">{t('pv.s6_h')}</h2>
    <p>{t('pv.s6_p')}</p>
  </section>

  <section id="contact">
    <h2 class="sh">{t('pv.s7_h')}</h2>
    <p>{t('pv.s7_p')}</p>
    <div class="contact-card">
      <p class="cc-name"><strong>Mathyu Solutions</strong></p>
      <p class="cc-line"><a href="mailto:xmathyu@gmail.com">xmathyu@gmail.com</a></p>
      <p class="cc-last"><a href="https://github.com/xMathyu/Calarm/issues" target="_blank" rel="noopener">github.com/xMathyu/Calarm/issues</a></p>
    </div>
  </section>
</main>

<footer>
  <div class="foot-row">
    <span>© 2026 Mathyu Solutions · Calarmi</span>
    <a href={homeHref}>{t('pv.foot_back')}</a>
  </div>
</footer>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(8, 9, 12, 0.78);
    backdrop-filter: blur(18px) saturate(160%);
    border-bottom: 1px solid var(--hair);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 750;
    font-size: 19px;
    letter-spacing: -0.02em;
  }
  .brand :global(img) {
    width: 32px;
    height: 32px;
    border-radius: 9px;
  }
  .spacer {
    flex: 1;
  }
  .back {
    font-size: 15px;
    color: var(--muted);
    font-weight: 550;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: color 0.2s;
  }
  .back:hover {
    color: var(--ink);
  }
  .back svg {
    width: 16px;
    height: 16px;
  }

  .doc {
    max-width: 760px;
    margin-inline: auto;
    padding: 64px 24px 110px;
  }
  .doc-head {
    margin-bottom: 44px;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 36px;
  }
  .doc-head .eyebrow {
    margin-bottom: 16px;
  }
  .doc-head h1 {
    font-size: clamp(34px, 6vw, 52px);
    margin-bottom: 16px;
  }
  .doc-head .lead {
    font-size: 19px;
    color: var(--muted);
  }
  .doc-head .updated {
    margin-top: 18px;
    font-size: 14px;
    color: var(--dim);
  }

  .tldr {
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    padding: 28px 30px;
    margin-bottom: 48px;
  }
  .tldr h2 {
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-2);
    margin-bottom: 16px;
  }
  .tldr ul {
    list-style: none;
    display: grid;
    gap: 13px;
  }
  .tldr li {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    font-size: 16px;
    color: #e2e3e6;
  }
  .tldr .chk {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(241, 104, 38, 0.15);
    color: var(--accent-2);
    display: grid;
    place-items: center;
    margin-top: 1px;
  }
  .tldr .chk svg {
    width: 14px;
    height: 14px;
  }

  .doc section {
    margin-bottom: 40px;
    scroll-margin-top: 80px;
  }
  .doc h2.sh {
    font-size: 24px;
    font-weight: 750;
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }
  .doc h3 {
    font-size: 17px;
    font-weight: 700;
    margin: 22px 0 8px;
  }
  .doc p {
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.7;
    margin-bottom: 14px;
  }
  .doc p :global(strong),
  .doc li :global(strong) {
    color: var(--ink);
    font-weight: 650;
  }
  .doc p :global(a),
  .doc li :global(a) {
    color: var(--accent-2);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .list {
    list-style: disc;
    padding-left: 22px;
    margin: 4px 0 18px;
    display: grid;
    gap: 10px;
  }
  .list li,
  .steps li {
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.7;
  }
  .list li {
    padding-left: 4px;
  }
  .list li::marker {
    color: var(--accent-2);
  }

  /* Deletion steps: numbered cards so the section stands out. */
  .steps {
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: 12px;
    margin: 6px 0 18px;
  }
  .steps li {
    counter-increment: step;
    position: relative;
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    padding: 18px 22px 18px 62px;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 20px;
    top: 19px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(241, 104, 38, 0.15);
    color: var(--accent-2);
    font-weight: 750;
    font-size: 15px;
    display: grid;
    place-items: center;
  }

  /* Lets the table scroll horizontally instead of cramping on narrow phones. */
  .tbl-wrap {
    margin: 18px 0 6px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--r-sm);
  }
  .tbl {
    width: 100%;
    min-width: 520px;
    border-collapse: collapse;
    font-size: 15px;
    border: 1px solid var(--hair);
    border-radius: var(--r-sm);
    overflow: hidden;
  }
  .tbl th,
  .tbl td {
    text-align: left;
    padding: 13px 16px;
    border-bottom: 1px solid var(--hair);
  }
  .tbl th {
    background: var(--bg-3);
    color: var(--muted);
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tbl td:first-child {
    color: var(--ink);
    font-weight: 600;
  }
  .tbl tr:last-child td {
    border-bottom: none;
  }
  .tbl .no {
    color: var(--dim);
  }

  .callout {
    background: var(--bg-2);
    border: 1px solid var(--hair);
    border-left: 3px solid var(--accent);
    border-radius: var(--r-sm);
    padding: 18px 22px;
    margin: 18px 0;
  }
  .callout p {
    margin: 0;
    font-size: 15.5px;
    color: #d2d3d7;
  }

  .contact-card {
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    padding: 26px 28px;
    margin-top: 8px;
  }
  .contact-card a {
    color: var(--accent-2);
    font-weight: 600;
  }
  .contact-card .cc-name {
    margin-bottom: 8px;
  }
  .contact-card .cc-line {
    margin-bottom: 6px;
  }
  .contact-card .cc-last {
    margin: 0;
  }

  footer {
    border-top: 1px solid var(--hair);
    padding-block: 36px;
  }
  .foot-row {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: 24px;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    color: var(--dim);
    font-size: 13px;
  }
  .foot-row a {
    color: var(--muted);
  }

  @media print {
    .nav,
    footer .foot-row a {
      display: none;
    }
    body {
      background: #fff;
      color: #111;
    }
  }
</style>
