---
import Layout from '../../layouts/Layout.astro';
import PrivacyDoc from '../../components/Privacy.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
const site = (Astro.site ?? new URL('https://calarm.mathyusolutions.com')).origin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Calarm', item: `${site}/en/` },
    { '@type': 'ListItem', position: 2, name: t('pv.title'), item: `${site}/en/privacy/` },
  ],
};
---

<Layout
  lang={lang}
  title={t('privacy.metaTitle')}
  description={t('privacy.metaDescription')}
  path="privacy"
  alternates={{ es: 'privacidad', en: 'privacy' }}
  jsonLd={jsonLd}
>
  <PrivacyDoc lang={lang} />
</Layout>
