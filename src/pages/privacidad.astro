---
import Layout from '../layouts/Layout.astro';
import PrivacyDoc from '../components/Privacy.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);
const site = (Astro.site ?? new URL('https://calarm-puce.vercel.app')).origin;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Calarm', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: t('pv.title'), item: `${site}/privacidad/` },
  ],
};
---

<Layout
  lang={lang}
  title={t('privacy.metaTitle')}
  description={t('privacy.metaDescription')}
  path="privacidad"
  alternates={{ es: 'privacidad', en: 'privacy' }}
  jsonLd={jsonLd}
>
  <PrivacyDoc lang={lang} />
</Layout>
